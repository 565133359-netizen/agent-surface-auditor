{
  "name": "agent-surface-auditor",
  "version": "0.1.0",
  "description": "Read-only static security checks for AI agent, Skill, plugin, MCP, and automation repositories.",
  "type": "module",
  "bin": {
    "agent-surface-auditor": "./bin/agent-surface-auditor.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "docs/assets",
    "examples",
    "src",
    "skill",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "scan:self": "node ./bin/agent-surface-auditor.js . --fail-on high",
    "scan:example": "node ./bin/agent-surface-auditor.js ./examples/minimal-agent --fail-on high"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agent",
    "security",
    "static-analysis",
    "skills",
    "mcp"
  ],
  "license": "MIT"
}
